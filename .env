# Copy this file to .env to override any defaults.
# All of these are optional — sensible defaults are already set in app/config.py.

HOST=0.0.0.0
PORT=8765

SAMPLE_RATE_HZ=16000
TARGET_FRAME_MS=20

# Jitter Buffer tuning — see app/config.py for what each one does.
# These are starting points, not measured values; revisit once you've
# done real jitter/packet-loss testing on a realistic network (per the
# architecture spec's transport risk note).
JITTER_TARGET_DELAY_MS=150
JITTER_MAX_WAIT_MS=400
JITTER_TICK_MS=10

DEBUG_OUTPUT_DIR=debug_output

# --- Segmentation (hybrid STT-completion + VAD) ---
# Reuse the same Deepgram API key from the benchmark project.
DEEPGRAM_API_KEY=2e81460558f4d412d45b6ae6e355f0a4386f4383
DEEPGRAM_MODEL=nova-2
SEGMENTATION_LANGUAGE=id

# Primary trigger: Deepgram's endpointing (ms). See app/config.py and
# app/segmentation.py for what each of these actually does.
# 50ms, not 300ms — real testing showed 300ms missed most natural
# pauses in conversational Indonesian speech. See app/config.py's
# comment on this field for the actual before/after data.
SEGMENTATION_ENDPOINTING_MS=50
# Fallback trigger: Deepgram's UtteranceEnd safety net (must be >= 1000).
SEGMENTATION_UTTERANCE_END_MS=1000
# Hard cap, not part of the original architecture spec design — an
# added safety net so no segment can grow unboundedly.
SEGMENTATION_MAX_DURATION_MS=15000

# --- Translation Pipeline (MT -> TTS per segment) ---
# Reuse the same keys from the benchmark project.
DEEPL_API_KEY=cbf988e4-c845-420d-83d5-a40f8850eb7d:fx
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
ELEVENLABS_API_KEY=sk_7a424c7c083658589621466415df673541b5825093f0fb9b
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

TRANSLATION_NUM_WORKERS=2
TRANSLATION_MAX_ATTEMPTS=2
TRANSLATION_DRAIN_TIMEOUT_S=30

# --- Question Mode (Student -> Teacher direction) ---
# Rule 12: a press held for less than this is treated as accidental and
# silently ignored.
QUESTION_MIN_DURATION_MS=300
# Optional: a separate ElevenLabs voice better suited for Indonesian
# output. If left blank, the question pipeline reuses ELEVENLABS_VOICE_ID
# (the same English lecture voice) — ElevenLabs' multilingual model can
# generally handle this, but a dedicated voice may sound more natural.
ELEVENLABS_VOICE_ID_QUESTION=


DATABASE_URL=postgresql://postgres:Denny77115@localhost:5432/blb_db
JWT_SECRET=GDGoC_ITB_Winner

EMAIL_BACKEND=console